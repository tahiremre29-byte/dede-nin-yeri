# DD1 Platform — Environment Variables
# Bu dosyayi .env olarak kopyalayip degerleri doldurun.
# Gercek anahtarlari GitHub'a eklemeyin.

# AI ayarlari
GEMINI_API_KEY=
DD1_ENV=development
AI_BACKEND_MODE=developer
GEMINI_MODEL_NAME=gemini-2.0-flash
AI_TIMEOUT_SECONDS=30
AI_RETRY_COUNT=3
STREAM_ENABLED=false

# Vertex AI (AI_BACKEND_MODE=vertex ise doldurun)
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# Halka acik beta: yalnizca anlasmasi ve teknik verisi dogrulanmis modeller.
# Ayirici: |  Ornek bicim: Model A|Model B
DD1_PUBLIC_BETA_MODE=true
DD1_APPROVED_MODELS=
DD1_PUBLIC_MATERIAL_MM=10
DD1_PUBLIC_KERF_MM=0.15

# Yonetim yazma islemleri icin uzun, rastgele anahtarlar.
DD1_ADMIN_KEY=
DD1_PREMIUM_KEY=

# Ayni origin kullaniliyorsa varsayilan degerler yeterlidir.
DD1_ALLOWED_ORIGINS=http://127.0.0.1:9000,http://localhost:9000

# Opsiyonel kalici veri konumlari.
# DD1_ARCHIVE_FILE=
# DD1_FEEDBACK_FILE=
# DD1_WOOFER_DB=
